#include <stdio.h>
#include <stdlib.h>

int main()
{	

	for (int i = 0; i < 4; i++)
	{
		for (int j = 0; j < 8; j++)
		{
			if (j - i >= 0 && j + i <= 6)
				printf("*");
			else
				printf(" ");


		}
		printf("\n");
	}


}

