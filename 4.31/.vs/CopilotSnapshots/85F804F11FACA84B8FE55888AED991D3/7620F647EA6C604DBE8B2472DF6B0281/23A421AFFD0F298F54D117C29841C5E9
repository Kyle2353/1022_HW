#include <stdio.h>
#include <stdlib.h>

int main()
{	

	for (int i = 0; i < 7; i++)
	{
		for (int j = 0; j < 8; j++)
		{
			if (j >= abs(i - 3) && j <= 6 - abs(i - 3))
				printf("*");
			else
				printf(" ");


		}
		printf("\n");
	}


}

